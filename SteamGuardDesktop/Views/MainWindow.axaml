<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SteamGuardDesktop.ViewModels"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="SteamGuardDesktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Steam Guard Desktop"
        Width="1040"
        Height="700"
        MinWidth="560"
        MinHeight="480">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SteamGuardDesktop/Views/ThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom"
            Padding="{DynamicResource PagePadding}">
      <TextBlock Text="{Binding StatusMessage}"
                 IsVisible="{Binding HasFailure}"
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel DockPanel.Dock="Top"
                Margin="{DynamicResource PagePadding}"
                Orientation="Horizontal"
                Spacing="8">
      <TextBlock VerticalAlignment="Center"
                 FontSize="20"
                 Text="Steam Guard Desktop" />
      <ComboBox x:Name="ThemeSelector"
                VerticalAlignment="Center"
                AutomationProperties.Name="Theme preference"
                SelectionChanged="OnThemePreferenceChanged" />
      <Button Content="Reveal account"
              IsVisible="{Binding AreAccountDetailsConcealed}"
              AutomationProperties.Name="Reveal concealed account details"
              Click="OnToggleAccountVisibilityClick" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*">
      <StackPanel Grid.Column="0"
                  Width="{DynamicResource SidebarWidth}"
                  Margin="{DynamicResource PagePadding}"
                  Spacing="8">
        <TextBlock Text="Accounts" />

        <ListBox ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding SelectedAccount}"
                 AutomationProperties.Name="Configured accounts">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItemViewModel">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Text="{Binding SteamIdentifier}"
                           FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Refresh code"
                Click="OnRefreshCodeClick" />
        <Button Content="Copy code"
                Click="OnCopyCodeClick" />
        <Button Content="Refresh confirmations"
                Click="OnRefreshConfirmationsClick" />
        <Button Content="Remove account"
                Click="OnRemoveAccountClick" />
      </StackPanel>

      <ScrollViewer Grid.Column="1"
                    Margin="{DynamicResource PagePadding}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Authenticator.CurrentCode}"
                     AutomationProperties.Name="Current Steam Guard code"
                     FontSize="{DynamicResource CodeDisplayFontSize}" />
          <TextBlock Text="{Binding Authenticator.RemainingSeconds}"
                     AutomationProperties.Name="Seconds remaining for the current code" />
          <TextBlock Text="The system clock differs from the Steam clock."
                     IsVisible="{Binding Authenticator.HasClockWarning}"
                     TextWrapping="Wrap" />
          <TextBlock Text="The account secrets are invalid or unavailable."
                     IsVisible="{Binding Authenticator.HasSecretProblem}"
                     TextWrapping="Wrap" />
          <TextBlock Text="The credential store is unavailable."
                     IsVisible="{Binding IsSecretStoreUnavailable}"
                     TextWrapping="Wrap" />
          <TextBlock Text="Account details are hidden while the window is inactive."
                     IsVisible="{Binding AreAccountDetailsConcealed}"
                     TextWrapping="Wrap" />

          <TextBlock Text="Pending confirmations" />

          <ListBox AutomationProperties.Name="Pending confirmations"
                   ItemsSource="{Binding Confirmations}"
                   SelectedItem="{Binding SelectedConfirmation}"
                   MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConfirmationItemViewModel">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Headline}" />
                  <TextBlock Text="{Binding TypeName}"
                             FontSize="12" />
                  <TextBlock Text="{Binding Summary}"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding ConfirmationDetails}"
                     IsVisible="{Binding HasConfirmationDetails}"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <TextBlock VerticalAlignment="Center"
                       FontSize="{DynamicResource StatusFontSize}"
                       Text="{Binding SelectedConfirmation.CreatedAtDisplay}" />
            <Button Content="Show details"
                    Click="OnShowDetailsClick" />
            <Button Content="Approve"
                    Click="OnApproveClick" />
            <Button Content="Deny"
                    Click="OnDenyClick" />
          </StackPanel>

          <TextBlock Text="Account setup" />

          <TextBox Watermark="Steam ID 64"
                   Text="{Binding AccountSetup.SteamIdentifier}" />
          <TextBox Watermark="Label"
                   Text="{Binding AccountSetup.Label}" />
          <TextBox Watermark="Shared secret"
                   Text="{Binding AccountSetup.SharedSecret}"
                   PasswordChar="{Binding AccountSetup.SecretMaskCharacter}" />
          <TextBox Watermark="Identity secret"
                   Text="{Binding AccountSetup.IdentitySecret}"
                   PasswordChar="{Binding AccountSetup.SecretMaskCharacter}" />
          <TextBox Watermark="Revocation code"
                   Text="{Binding AccountSetup.RevocationCode}"
                   PasswordChar="{Binding AccountSetup.SecretMaskCharacter}" />
          <TextBox Watermark="Access token"
                   Text="{Binding AccountSetup.AccessToken}"
                   PasswordChar="{Binding AccountSetup.SecretMaskCharacter}" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Button Content="Save account"
                    Click="OnSaveAccountClick" />
            <Button Content="Reveal secrets"
                    IsVisible="{Binding AccountSetup.IsSecretRevealAllowed}"
                    Click="OnToggleSecretVisibilityClick" />
          </StackPanel>

          <TextBlock Text="Sign in and authenticator recovery" />

          <TextBox Watermark="Account name"
                   Text="{Binding Recovery.AccountName}" />
          <TextBox Watermark="Password"
                   Text="{Binding Recovery.Password}"
                   PasswordChar="*" />
          <Button Content="Sign in"
                  Click="OnBeginSignInClick" />

          <TextBlock Text="{Binding Recovery.GuardMessage}"
                     IsVisible="{Binding Recovery.IsSignInStarted}"
                     TextWrapping="Wrap" />
          <TextBox Watermark="Guard code"
                   IsVisible="{Binding Recovery.IsCodeRequired}"
                   Text="{Binding Recovery.GuardCode}" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding Recovery.IsSignInStarted}">
            <Button Content="Submit code"
                    IsVisible="{Binding Recovery.IsCodeRequired}"
                    Click="OnSubmitGuardCodeClick" />
            <Button Content="Complete sign-in"
                    Click="OnCompleteSignInClick" />
          </StackPanel>

          <TextBlock Text="Authenticator"
                     IsVisible="{Binding Recovery.IsGuardSubmitted}" />
          <TextBox Watermark="Revocation code"
                   IsVisible="{Binding Recovery.IsGuardSubmitted}"
                   Text="{Binding Recovery.RecoveryCode}"
                   PasswordChar="*" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding Recovery.IsGuardSubmitted}">
            <Button Content="Check status"
                    Click="OnCheckAuthenticatorStatusClick" />
            <Button Content="Remove authenticator"
                    Click="OnRemoveAuthenticatorClick" />
            <Button Content="Enrol authenticator"
                    Click="OnEnrolAuthenticatorClick" />
            <Button Content="Activate authenticator"
                    Click="OnFinalizeAuthenticatorClick" />
          </StackPanel>

          <TextBox Watermark="SMS code"
                   IsVisible="{Binding Recovery.IsRecoveringLostDevice}"
                   Text="{Binding Recovery.SmsCode}" />
          <Button Content="Recover lost device"
                  IsVisible="{Binding Recovery.IsRecoveringLostDevice}"
                  Click="OnRecoverLostDeviceClick" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>