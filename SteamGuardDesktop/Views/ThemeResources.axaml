<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Thickness x:Key="PagePadding">16</Thickness>
  <Thickness x:Key="SectionSpacing">0,12,0,0</Thickness>
  <Thickness x:Key="InlineSpacing">0,4,0,0</Thickness>
  <x:Double x:Key="WideLayoutMinimumWidth">720</x:Double>
  <x:Double x:Key="NarrowLayoutMaximumWidth">480</x:Double>
  <x:Double x:Key="CodeDisplayFontSize">48</x:Double>
  <GridLength x:Key="SidebarWidth">240</GridLength>
</ResourceDictionary>
