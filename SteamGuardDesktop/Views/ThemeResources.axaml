<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF1B1D21" />
  <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFE6E8EB" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF23262B" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF353941" />
  <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FF9AA1AC" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#FF3FBF6F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFE0A020" />
  <SolidColorBrush x:Key="FailureBrush" Color="#FFE05A5A" />

  <Thickness x:Key="PagePadding">16</Thickness>
  <Thickness x:Key="PanelPadding">12</Thickness>
  <Thickness x:Key="SectionSpacing">0,12,0,0</Thickness>

  <x:Double x:Key="HeadingFontSize">20</x:Double>
  <x:Double x:Key="BodyFontSize">14</x:Double>
  <x:Double x:Key="StatusFontSize">12</x:Double>
  <x:Double x:Key="CodeDisplayFontSize">48</x:Double>
  <x:Double x:Key="SidebarWidth">240</x:Double>
</ResourceDictionary>
